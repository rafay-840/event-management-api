# Copy this file to .env and adjust the values for your machine.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/event_management

# Set to true to print every SQL statement in the console.
SQL_ECHO=false

# Time zone for the ?date= filter on GET /events (IANA name).
APP_TIMEZONE=UTC

# JWT settings. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
